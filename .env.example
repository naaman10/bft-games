# Brighter Futures Learn API URL
# This is the backend API that provides authenticated game sessions and questions
# 
# For local development with bft-api running locally:
VITE_BFT_API_URL=http://localhost:4000
#
# For production/staging deployment:
# VITE_BFT_API_URL=https://api.brighterfuturestutoring.com
#
# Note: The game will work without this (using local questions) but 
# authenticated mode requires a running bft-api server with:
# 1. Migration 009_gem_hunt_tables.sql applied
# 2. Questions populated via populate_questions.sql
# 3. Valid JWT tokens for authentication
